# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only; used by View 5 commentary route (added in V4).
ANTHROPIC_API_KEY=your-anthropic-key
# Server-only; required by the Admin "Reset tournament" route (/api/reset).
# Service-role key: Supabase dashboard → Project Settings → API → service_role.
# It can bypass RLS, so it MUST stay server-side (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Passphrase you must type to confirm a full reset. Pick anything; only you
# know it. Compared server-side and never shipped to the browser.
ADMIN_RESET_TOKEN=choose-a-passphrase
